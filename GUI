local function getCurrentCash()
    if not LocalPlayer then return 0 end

    -- [1] Prioritas: Framework module (sama kayak Shop.MeetsItemRequirements)
    if EconomyModule then
        local ok, val = pcall(function()
            -- coba fungsi umum yang biasa ada di module economy
            return EconomyModule.GetCash and EconomyModule.GetCash(LocalPlayer)
                or EconomyModule.GetBalance and EconomyModule.GetBalance(LocalPlayer)
                or EconomyModule.GetCurrency and EconomyModule.GetCurrency(LocalPlayer)
        end)
        if ok and type(val) == "number" and val > 0 then
            return val
        end
    end

    if CurrencyModule then
        local ok, val = pcall(function()
            return CurrencyModule.Get and CurrencyModule.Get(LocalPlayer)
                or CurrencyModule.GetCash and CurrencyModule.GetCash(LocalPlayer)
        end)
        if ok and type(val) == "number" and val > 0 then
            return val
        end
    end

    -- [2] Fallback: leaderstats (ValueObject)
    local maxCash = 0
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        for _, name in ipairs({ "Cash", "Money", "Coins", "Balance", "Dollars", "Credits" }) do
            local c = ls:FindFirstChild(name)
            if c and c:IsA("ValueBase") then
                local str = tostring(c.Value):gsub(",", ""):gsub("%$", "")
                maxCash = math.max(maxCash, tonumber(str) or 0)
            end
        end
    end
    if maxCash > 0 then return maxCash end

    -- [3] Fallback: player Attributes (pola yang sama kayak shop check requirements)
    for k, v in pairs(LocalPlayer:GetAttributes()) do
        local kLow = k:lower()
        if kLow:find("cash") or kLow:find("money") or kLow:find("currency") or kLow:find("coins") or kLow:find("balance") then
            local str = tostring(v):gsub(",", ""):gsub("%$", "")
            maxCash = math.max(maxCash, tonumber(str) or 0)
        end
    end

    return maxCash
end

