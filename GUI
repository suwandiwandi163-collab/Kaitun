local function formatNumber(n)
    local formatted = tostring(math.floor(n))
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return formatted
end

-- =============================================================
-- SCRIPT EXECUTE TIME
-- Dicatat begitu script ini jalan (os.clock() gak kepengaruh
-- perubahan jam sistem, cocok buat itung elapsed duration).
-- =============================================================
local ScriptStartTime = os.clock()

local function formatElapsed()
    local elapsed = math.floor(os.clock() - ScriptStartTime)
    if elapsed < 0 then elapsed = 0 end
    local hh = math.floor(elapsed / 3600)
    local mm = math.floor((elapsed % 3600) / 60)
    local ss = elapsed % 60
    return string.format("%02d:%02d:%02d", hh, mm, ss)
end

