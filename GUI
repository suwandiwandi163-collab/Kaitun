local OriginalRenderState = {
    captured = false,
    qualityLevel = nil,
    globalShadows = nil,
    terrainDecoration = nil,
}

local function captureOriginalRenderState()
    if OriginalRenderState.captured then return end
    pcall(function()
        if UserGameSettings then
            OriginalRenderState.qualityLevel = UserGameSettings.SavedQualityLevel
        end
    end)
    pcall(function()
        OriginalRenderState.globalShadows = Lighting.GlobalShadows
    end)
    pcall(function()
        OriginalRenderState.terrainDecoration = workspace.Terrain.Decoration
    end)
    OriginalRenderState.captured = true
end

local function setLowRenderMode(enabled)
    captureOriginalRenderState()

    if enabled then
        pcall(function()
            if UserGameSettings then
                UserGameSettings.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
            end
        end)
        pcall(function()
            Lighting.GlobalShadows = false
        end)
        pcall(function()
            workspace.Terrain.Decoration = false
        end)
    else
        pcall(function()
            if UserGameSettings and OriginalRenderState.qualityLevel then
                UserGameSettings.SavedQualityLevel = OriginalRenderState.qualityLevel
            end
        end)
        pcall(function()
            if OriginalRenderState.globalShadows ~= nil then
                Lighting.GlobalShadows = OriginalRenderState.globalShadows
            end
        end)
        pcall(function()
            if OriginalRenderState.terrainDecoration ~= nil then
                workspace.Terrain.Decoration = OriginalRenderState.terrainDecoration
            end
        end)
    end
end

