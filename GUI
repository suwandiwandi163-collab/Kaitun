-- =============================================================
-- CPM (CASH PER MINUTE) — REALTIME
-- Ngambil data dari getCurrentCash() yang udah ada, di-sample tiap
-- 1 detik ke rolling window 60 detik. CPM dihitung dari total
-- KENAIKAN cash di window itu (bukan selisih akhir-awal polos),
-- biar CPM gak jatoh ke negatif kalau cash turun karena belanja/spend
-- — itu bukan bagian dari "pendapatan per menit".
-- =============================================================
local CPM_WINDOW_SECONDS = 60
local cashHistory = {} -- array of {t = os.clock(), cash = number}

local function pushCashSample(cash)
    local t = os.clock()
    table.insert(cashHistory, {t = t, cash = cash})
    -- buang sample yang udah keluar window
    while #cashHistory > 0 and (t - cashHistory[1].t) > CPM_WINDOW_SECONDS do
        table.remove(cashHistory, 1)
    end
end

local function computeCpm()
    if #cashHistory < 2 then return 0 end

    local earned = 0
    for i = 2, #cashHistory do
        local delta = cashHistory[i].cash - cashHistory[i - 1].cash
        if delta > 0 then
            earned = earned + delta
        end
    end

    local elapsedSeconds = cashHistory[#cashHistory].t - cashHistory[1].t
    if elapsedSeconds <= 0 then return 0 end

    local elapsedMinutes = elapsedSeconds / 60
    return earned / elapsedMinutes
end

State.cpm = State.cpm or "-"

local function updateCpmLabel()
    local displayVal
    if type(State.cpm) == "number" then
        displayVal = "$" .. formatNumber(State.cpm) .. "/min"
    else
        displayVal = tostring(State.cpm)
    end
    CpmLabel.Text = string.format(
        '<font color="#FEF08A">Cpm:</font>   <font color="#FFFFFF"><b>%s</b></font>',
        displayVal
    )
end
updateCpmLabel()

-- Sample cash tiap 1 detik buat isi rolling window, terus hitung ulang CPM
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            pushCashSample(getCurrentCash())
            State.cpm = computeCpm()
            updateCpmLabel()
        end)
    end
end)

